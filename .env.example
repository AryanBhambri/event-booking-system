# Copy this file to .env and enter your own local MySQL credentials.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
# Set this to true only when the deployed site uses HTTPS.
SESSION_COOKIE_SECURE=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=event_booking_system
MYSQL_CONNECT_TIMEOUT=10
# Optional for a remote MySQL server: trusted CA certificate file path.
MYSQL_SSL_CA=
# In production, comma-separated public hostnames (without scheme or port).
TRUSTED_HOSTS=

# Event banner storage. Set real values in Render's environment, never in Git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
